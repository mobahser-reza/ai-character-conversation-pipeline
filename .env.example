# Copy to .env and fill in real values before running docker compose up.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@postgres:5432/pipeline
SYNC_DATABASE_URL=postgresql+psycopg2://pipeline:pipeline@postgres:5432/pipeline

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=change-me-32-byte-fernet-key-base64=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/media
# Absolute base URL this backend is reachable at - required so generated media URLs
# are fetchable by external providers (HeyGen, Runway) as well as the frontend.
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

CORS_ORIGINS=["http://localhost:3000"]
